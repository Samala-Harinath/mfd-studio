DATABASE_URL=postgres://postgres:password@127.0.0.1:5432/mfd-studio
# Neon on Vercel: use the direct (non-pooler) URL for migrations and Payload. Vercel often sets POSTGRES_URL_NON_POOLING automatically.
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Every MFD site is also served at <slug>.<root domain>. In production use your real domain, e.g. mfdstudio.in
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000

# Optional. The address Payload admin Live Preview opens, e.g. https://mfdstudio.in. Leave empty to use the current address.
NEXT_PUBLIC_SERVER_URL=
